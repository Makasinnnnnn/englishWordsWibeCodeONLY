generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Word {
  id                String    @id @default(cuid())
  userId            String?
  english           String
  englishNormalized String
  translation       String
  association       String?
  imageUrl          String?
  notes             String?
  difficulty        String    @default("medium")
  learningLevel     Int       @default(0)
  correctCount      Int       @default(0)
  wrongCount        Int       @default(0)
  typoCount         Int       @default(0)
  reviewCount       Int       @default(0)
  streak            Int       @default(0)
  lastResult        String?
  isLearned         Boolean   @default(false)
  lastReviewedAt    DateTime?
  nextReviewAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, englishNormalized])
  @@index([userId])
}

model User {
  id              String               @id @default(cuid())
  email           String?              @unique
  username        String?              @unique
  passwordHash    String?
  displayName     String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  words           Word[]
  sessions        Session[]
  telegram        TelegramAccount?
  resetTokens     PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TelegramAccount {
  id         String   @id @default(cuid())
  userId     String   @unique
  telegramId String   @unique
  username   String?
  firstName  String?
  lastName   String?
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([telegramId])
}

model TelegramLoginToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  purpose    String    @default("auth")
  userId     String?
  telegramId String?
  username   String?
  firstName  String?
  lastName   String?
  photoUrl   String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([expiresAt])
  @@index([purpose])
  @@index([userId])
  @@index([telegramId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
